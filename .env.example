# Port the API listens on.
PORT=4000

# Secret used to sign admin login tokens. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# MySQL connection. Either one URL...
#   DATABASE_URL=mysql://doctor:your-password@127.0.0.1:3306/doctor_clinic
# ...or the separate settings below (used when DATABASE_URL is empty).
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=doctor
MYSQL_PASSWORD=
MYSQL_DATABASE=doctor_clinic

# Folder for uploaded patient PDFs (the PDF files themselves are not stored in MySQL).
# Keep it on a persistent disk and back it up together with the database.
UPLOAD_DIR=data/uploads
# Largest PDF accepted, in MB.
MAX_UPLOAD_MB=20
# Minutes a patient can open their PDFs after entering their file number and phone number.
PATIENT_ACCESS_MINUTES=30

# First admin account, created only when the database has no admins yet.
# Log in and change the password from the Account page straight away.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Frontend address(es) allowed to call the API, comma separated. "*" allows any.
CORS_ORIGINS=*

# Number of reverse proxies in front of the API (1 on Render, Railway, Nginx...).
# Needed so rate limiting sees the real visitor IP. Leave empty when not behind a proxy.
TRUST_PROXY=

# Failed patient lookups allowed per visitor in the window below.
LOOKUP_MAX_ATTEMPTS=10
LOOKUP_WINDOW_MINUTES=15
