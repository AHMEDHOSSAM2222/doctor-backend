# Copy to deploy/.env and fill in. Never commit the real .env.
# Make each secret with:  openssl rand -hex 24

# The domain the clinic site runs on (its DNS A record must point at this server).
# HTTPS certificates are created automatically. For a first test without a domain use :80
# and open http://<server IP>; do not enter real patient data until HTTPS works.
DOMAIN=clinic.example.com

# Name shown on the patient page and the QR poster.
CLINIC_NAME=Clinic

# First staff login. The password is used only on the very first start; change it later
# from the Account page.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Database passwords: long random values, different from each other.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Optional
# Secret that signs staff logins. Leave empty to have one created and kept in the database.
JWT_SECRET=
MAX_UPLOAD_MB=20
PATIENT_ACCESS_MINUTES=30
